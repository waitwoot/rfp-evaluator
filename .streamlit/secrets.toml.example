# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> Manage app -> Settings -> Secrets.
#
# .streamlit/secrets.toml is gitignored. Never commit a real key.
# Use straight quotes and no trailing spaces.

LLM_PROVIDER = "openai"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL    = "openai/gpt-oss-120b"
LLM_API_KEY  = "gsk_replace_with_your_own_key"

# Leave LLM_PROVIDER = "mock" to run offline with the deterministic
# keyword scorer and no API key at all.
